<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <!-- Surum tek yerden yonetilir. Release tag'i (vX.Y.Z) bununla ayni olmalidir. -->
    <Version>0.1.0</Version>
    <Product>WorkLogger</Product>
    <Authors>Mehmet Ozdemir</Authors>
    <Copyright>Copyright (c) 2026 Mehmet Ozdemir</Copyright>
    <RepositoryUrl>https://github.com/mehmedozdemir/WorkLogger-Desktop</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
