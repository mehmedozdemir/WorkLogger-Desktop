<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:WorkLogger.Desktop.Controls">

  <!-- Tipografi -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.h1">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.overline">
    <Setter Property="FontSize" Value="11.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="0.4" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
  </Style>
  <Style Selector="TextBlock.kpi">
    <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontFeatures" Value="+tnum" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBlock.num">
    <Setter Property="FontFeatures" Value="+tnum" />
  </Style>
  <Style Selector="TextBlock.key">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13.5" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <!-- Kart -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
    <Setter Property="Padding" Value="20,18" />
    <Setter Property="BoxShadow" Value="0 1 2 0 #0D101828" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="Background" Value="{DynamicResource NeutralSoftBrush}" />
  </Style>
  <Style Selector="Border.pill.accent">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>
  <Style Selector="Border.pill.positive">
    <Setter Property="Background" Value="{DynamicResource PositiveSoftBrush}" />
  </Style>
  <Style Selector="Border.pill.warning">
    <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
  </Style>

  <!-- Gezinme -->
  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="13.5" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.nav.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource NavSelectedBrush}" />
  </Style>

  <!-- Düğmeler -->
  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="12,6" />
  </Style>
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
  </Style>
  <Style Selector="Button.segment.selected">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.segment.selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  </Style>

  <!-- Simgeler (Segoe Fluent Icons; yoksa MDL2) -->
  <Style Selector="TextBlock.glyph">
    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Girdi -->
  <Style Selector="TextBox">
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="NumericUpDown">
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Grafikler: tema fırçaları -->
  <Style Selector=":is(c|ChartBase)">
    <Setter Property="TextBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="MutedBrush" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="TrackBrush" Value="{DynamicResource TrackBrush}" />
    <Setter Property="GridBrush" Value="{DynamicResource DividerBrush}" />
    <Setter Property="AccentBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="SurfaceBrush" Value="{DynamicResource SurfaceBrush}" />
  </Style>
  <Style Selector="c|TimelineBar">
    <Setter Property="IdleBrush" Value="{DynamicResource IdleBrush}" />
    <Setter Property="UnclassifiedBrush" Value="{DynamicResource UnclassifiedBrush}" />
  </Style>
</Styles>
