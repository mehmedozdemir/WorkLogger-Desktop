<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:WorkLogger.Desktop.ViewModels"
             xmlns:v="using:WorkLogger.Desktop.Views"
             x:Class="WorkLogger.Desktop.App"
             Name="WorkLogger"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://WorkLogger/Theme/Palette.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://WorkLogger/Theme/Styles.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="vm:DayViewModel">
      <v:DayView />
    </DataTemplate>
    <DataTemplate DataType="vm:HistoryViewModel">
      <v:HistoryView />
    </DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel">
      <v:SettingsView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
